#!/usr/bin/python
"""Show wvkbd from read-only Fcitx focus metadata while in tablet mode."""

import fcntl
import logging
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time

import dbus

SERVICE = "pixelbook-osk.service"
FOCUSED = re.compile(r"^\s+IC \[([0-9a-f]+)\].* frontend:\S+ cap:[0-9a-f]+ focus:1$", re.M)
EVIOCGSW = (2 << 30) | (8 << 16) | (ord("E") << 8) | 0x1B
logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")


def tablet_mode():
    for event in Path("/sys/class/input").glob("event*"):
        try:
            if (event / "device/name").read_text().strip() != "Tablet Mode Switch":
                continue
            with open(Path("/dev/input") / event.name, "rb", buffering=0) as device:
                state = bytearray(8)
                fcntl.ioctl(device, EVIOCGSW, state)
                return bool(state[0] & 2)
        except FileNotFoundError:
            continue
    raise RuntimeError("Tablet Mode Switch is unavailable")


def focused_context(controller):
    # DebugInfo contains context IDs, program names, capabilities and focus;
    # it does not require reading or recording any text entered by the user.
    info = str(controller.DebugInfo(timeout=1))
    if "Input Context without group" not in info:
        raise RuntimeError("Unrecognized Fcitx focus-status format")
    match = FOCUSED.search(info)
    return match.group(1) if match else None


def external_keyboard_connected(input_root=Path("/sys/class/input")):
    for event in input_root.glob("event*"):
        # uinput devices such as keyd can claim a USB bus ID. Bluetooth UHID
        # keyboards live under virtual/misc/uhid and must still be counted.
        if "/devices/virtual/input/" in str(event.resolve()):
            continue
        try:
            bus = (event / "device/id/bustype").read_text().strip()
            if bus not in ("0003", "0005"):  # BUS_USB, BUS_BLUETOOTH
                continue
            result = subprocess.run(
                ["udevadm", "info", "--query=property", "--path", str(event)],
                capture_output=True, text=True, timeout=1, check=True)
        except FileNotFoundError:
            if not event.exists():
                continue  # Unplugged during enumeration.
            raise
        except subprocess.CalledProcessError:
            if not event.exists():
                continue
            raise
        properties = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
        if properties.get("ID_INPUT_KEYBOARD") == "1":
            return True
    return False


def main():
    if sys.argv[1:] == ["--toggle"]:
        subprocess.run(["systemctl", "--user", "start", SERVICE], check=True)
        subprocess.run(["systemctl", "--user", "kill", "--kill-whom=main",
                        "--signal=SIGUSR1", SERVICE], check=True)
        return
    if sys.argv[1:]:
        raise SystemExit("Usage: pixelbook-osk [--toggle]")

    runtime = Path(os.environ["XDG_RUNTIME_DIR"])
    lock = open(runtime / "pixelbook-osk.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        return

    running = True
    toggle = False

    def stop(*_):
        nonlocal running
        running = False

    def request_toggle(*_):
        nonlocal toggle
        toggle = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGUSR1, request_toggle)
    child = controller = bus = None
    previous_mode = previous_focus = None
    external = False
    next_keyboard_check = 0.0
    last_error = None
    try:
        while running:
            try:
                if child is None or child.poll() is not None:
                    if child is not None:
                        raise RuntimeError("wvkbd exited unexpectedly")
                    # Fcitx continues to own the input-method connection.
                    # wvkbd only injects virtual keystrokes; do not use --auto.
                    child = subprocess.Popen([str(Path.home() / ".local/share/omarchy-pixelbook/wvkbd-german"), "--hidden",
                                              "-H", "280", "-L", "240"])
                    time.sleep(0.2)
                folded = tablet_mode()
                if folded:
                    now = time.monotonic()
                    if now >= next_keyboard_check:
                        external = external_keyboard_connected()
                        next_keyboard_check = now + 1
                else:
                    external = False
                    next_keyboard_check = 0.0
                automatic = folded and not external
                mode = (folded, external)
                focus = None
                if automatic:
                    if controller is None:
                        bus = dbus.SessionBus(private=True)
                        controller = dbus.Interface(bus.get_object(
                            "org.fcitx.Fcitx5", "/controller"),
                            "org.fcitx.Fcitx.Controller1")
                    focus = focused_context(controller)

                if mode != previous_mode or (automatic and focus != previous_focus):
                    child.send_signal(signal.SIGUSR2 if automatic and focus else signal.SIGUSR1)
                    if mode != previous_mode:
                        reason = "disabled (external keyboard)" if external else "enabled (tablet)" if folded else "disabled (laptop)"
                        logging.info("Automatic keyboard %s", reason)
                    previous_mode, previous_focus = mode, focus

                if toggle:
                    child.send_signal(signal.SIGRTMIN)
                    toggle = False
                last_error = None
                time.sleep(0.25)
            except (OSError, RuntimeError, dbus.DBusException, subprocess.SubprocessError) as error:
                if str(error) != last_error:
                    logging.error("%s", error)
                    last_error = str(error)
                if child is not None:
                    if child.poll() is None:
                        child.send_signal(signal.SIGUSR1)
                    else:
                        child = None
                if bus is not None:
                    bus.close()
                controller = bus = None
                previous_mode = previous_focus = None
                time.sleep(2)
    finally:
        if child is not None and child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=3)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()
        if bus is not None:
            bus.close()
        lock.close()


if __name__ == "__main__":
    main()
